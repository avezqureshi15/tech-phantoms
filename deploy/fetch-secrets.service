[Unit]
Description=Load Diya application secrets into an in-memory filesystem
Wants=network-online.target
After=network-online.target
Before=docker.service
RequiresMountsFor=/run/secrets

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/diya/fetch-secrets.env
ExecStartPre=/opt/diya/mount-secrets.sh
ExecStart=/usr/bin/python3 /opt/diya/fetch-secrets.py
ExecStop=/usr/bin/umount /run/secrets

[Install]
WantedBy=multi-user.target
