{
  "name": "diya-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "prisma:generate": "tsx scripts/prisma.ts generate",
    "prisma:push": "tsx scripts/prisma.ts db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-outbound": "tsx prisma/seed-outbound.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "bootstrap:demo": "tsx scripts/bootstrap-demo.ts",
    "restore:demo-admins": "tsx scripts/restore-demo-admins.ts"
  },
  "dependencies": {
    "@flagsmith/nodejs": "^9.5.0",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "openai": "^7.63.0",
    "twilio": "^6.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "effect": "3.22.5"
  }
}
