# Postgres (Neon) connection string
DATABASE_URL=

# Sarvam AI — STT (saaras:v3), TTS (bulbul:v3), Token Factory LLM
SARVAM_API_KEY=

# Flagsmith server-side SDK key (never the client/environment key)
FLAGSMITH_SERVER_KEY=

# NudgeBee workflow trigger + callback verification
NUDGEBEE_WEBHOOK_URL=
APPROVAL_CALLBACK_SECRET=

# Publicly reachable base URL for this server, used to build the
# Twilio webhooks, audio URLs, and the NudgeBee callback. Read per request;
# set to the current public HTTPS tunnel/deployment URL (never localhost).
PUBLIC_BASE_URL=

# Outbound calling is fail-closed.
OUTBOUND_CALLING_ENABLED=false
CALLABLE_QUERY_CATEGORIES=sweets,apparel,decor,gifting
MAX_TURNS_PER_CALL=8
MAX_CALL_DURATION_SEC=180
CALL_WINDOW_START=09:00
CALL_WINDOW_END=21:00

# Twilio Programmable Voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Session authentication. Invitation-only accounts; no shared operator token.
SESSION_COOKIE_NAME=diya_session
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_HOURS=168
INVITE_TTL_HOURS=168
# Read by `npm run bootstrap:admin`; no password is ever stored here.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Platform admin

# Local dev. Must match the client origin (cookies ignore port).
PORT=4002
CLIENT_ORIGIN=http://localhost:5174

# Twilio trial accounts can only dial numbers verified in the console.
# Comma-separated E.164 list the seeder assigns to demo customers, e.g.
#   DEMO_VERIFIED_NUMBERS=+911234567890,+919876543210
# Leave blank to keep the fictional placeholder numbers. Set this in
# .env.local only — real personal numbers must never enter tracked files.
DEMO_VERIFIED_NUMBERS=

# FestiveOS integration (mobile backend asks for a call back)
# Shared HMAC secret; the mobile backend uses the same value as DIYA_INTEGRATION_SECRET.
INTEGRATION_SECRET=
# The tenant that FestiveOS users become customers of.
INTEGRATION_TENANT_SLUG=festiveos
# Remember: CALLABLE_QUERY_CATEGORIES must include festiveos_support for these to be called automatically.
